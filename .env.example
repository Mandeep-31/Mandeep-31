# Environment variables for mandeepacharya.com.np (Next.js static export).
#
# IMPORTANT — NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD
# time, not read at runtime. For the deployed site:
#   1. Add these in Cloudflare Pages → Settings → Environment variables.
#   2. Redeploy — an existing deployment keeps whatever was inlined when it
#      was built. Changing a var without rebuilding changes nothing.
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# --- EmailJS contact form (components/portfolio/ContactForm.tsx) ---
# Cloudflare dashboard → EmailJS → Account. Without all three every
# emailjs.send() fails and the form shows "Something didn't go through".
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Cloudflare Web Analytics beacon (app/layout.tsx) ---
# Optional. Leave empty (or unset) to render NO beacon script at all.
# When set, the beacon is served by React via next/script. Keep Cloudflare
# Pages' "Web Analytics" auto-injection OFF for this project so the beacon
# isn't injected twice / outside React's tree (the auto-injected copy inside
# <body> can break React hydration → React error #418).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Optional: only when serving from a repo subpath instead of the domain root ---
# NEXT_BASE_PATH=/Mandeep-31
