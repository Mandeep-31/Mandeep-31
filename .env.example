# Environment variables for mandeepacharya.com.np (Next.js static export).
#
# IMPORTANT — NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD
# time, not read at runtime. For the deployed site (GitHub Pages, built by
# .github/workflows/deploy.yml):
#   1. Add these under repo Settings → Secrets and variables → Actions
#      (Actions secrets), NOT Cloudflare or any other host.
#   2. Re-run the Deploy workflow — a build only sees the secrets that
#      existed when it started.
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# --- EmailJS contact form (components/portfolio/ContactForm.tsx) ---
# Cloudflare dashboard → EmailJS → Account. Without all three every
# emailjs.send() fails and the form shows "Something didn't go through".
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=


# --- Optional: only when serving from a repo subpath instead of the domain root ---
# NEXT_BASE_PATH=/Mandeep-31
